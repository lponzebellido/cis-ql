LOAD SEQUENCE "data_examples/ecoli2.fna" AS genome;

FIND MOTIF "TATA[AT]A[AT]" STRAND POSITIVE AS anchors;

FIND MOTIF "ATG(?:(?!TAA|TAG|TGA)[ACGT]{3})*(?:TAA|TAG|TGA)"
  WITHIN 200 BP DOWNSTREAM FROM anchors
  STRAND POSITIVE
  AS orfs
  WHERE LENGTH >= 15 BP
    AND LENGTH MOD 3 = 0
    AND SLICE ORIENTED_SEQUENCE FROM 0 TO 3 = "ATG"
    AND (
      SLICE ORIENTED_SEQUENCE FROM -3 TO END = "TAA"
      OR SLICE ORIENTED_SEQUENCE FROM -3 TO END = "TAG"
      OR SLICE ORIENTED_SEQUENCE FROM -3 TO END = "TGA"
    );

EXPORT orfs TO "orfs.tsv" FORMAT TSV;
